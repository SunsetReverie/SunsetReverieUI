{
  "name": "@sunset-reverie/ui",
  "version": "1.0.0-beta.5",
  "license": "MIT",
  "description": "夕梦 UI —— SunsetReverie-UI 核心组件库",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base.css": "./dist/base.css",
    "./style.css": "./dist/style.css",
    "./components/*/style.css": "./dist/components/*/style.css",
    "./*/style.css": "./dist/components/*/style.css",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json",
    "./draggable.css": "./dist/draggable.css"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.2"
  },
  "devDependencies": {
    "@sunset-reverie/icons": "workspace:*",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "less": "^4.2.0",
    "tinyglobby": "^0.2.9",
    "vite": "^5.4.9",
    "vite-plugin-dts": "^4.2.4",
    "vitest": "^2.1.3",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/build-styles.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
