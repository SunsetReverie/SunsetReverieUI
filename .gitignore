# 依赖
node_modules/

# 构建产物（不入库，发版时由 pnpm release:pack 打成 tarball 挂到 Git Release）
dist/
*.tsbuildinfo

# 发版 tarball（pnpm release:pack 产出，上传到 Release 后无需入库）
release/

# Token 生成物（由 pnpm build:tokens 产出，源文件是 internal/tokens/src/tokens.ts）
packages/ui/src/tokens/generated/
packages/ui/src/styles/base/primitives.generated.css
packages/ui/src/styles/base/semantic.generated.css

# Token 验证页（由 pnpm build:gallery 产出）
docs/public/token-gallery.html

# 测试与缓存
coverage/
.vite/
.eslintcache
.stylelintcache

# Nuxt
.nuxt/
.output/
.nitro/
.cache/

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/

# 环境与日志
.env
.env.*
!.env.example
*.log
npm-debug.log*
pnpm-debug.log*

# 系统
.DS_Store
Thumbs.db
test-results/
playwright-report/
blob-report/

# vite 临时配置产物
*.timestamp-*.mjs

# ------------------------------------------------------------------
# 以下内容只保留在本地，不进远程仓库。
#
# 仓库定位是「使用框架必需文件的来源」：别人从 tag 安装只需要 packages/、
# internal/ 与构建配置。测试资产、演示站、内部评审材料留在本地即可。
# 注意：这些文件已从 Git 索引移出，工作区文件仍在，本地照常开发与运行。
# ------------------------------------------------------------------

# 视觉基线、e2e 与 Playwright 配置（测试资产）
visual/
e2e/
playwright.config.ts
playwright.visual.config.ts

# 演示站（消费方示例工程，不是库本身的必需文件）
playground-vue3/
playground-nuxt4/

# 内部规划材料（文档站 srcExclude 已排除，仅评审用）
docs/夕梦UI组件库开发规划.md
docs/夕梦UI组件库开发规划.html
docs/SrMarkdown组件规划.md

# CI 流水线需要跟着仓库走：发布 tarball 由 GitHub Actions 在打 tag 时自动构建
# （.github 不再忽略）
