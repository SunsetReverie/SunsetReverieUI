{
  "name": "sunsetreverie-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter playground-vue3 dev",
    "dev:vue3": "pnpm --filter playground-vue3 dev",
    "build:tokens": "pnpm --filter @sunset-reverie/internal-tokens build",
    "build:gallery": "pnpm run build:tokens && pnpm --filter @sunset-reverie/internal-tokens build:gallery",
    "build:icons": "pnpm run build:tokens && pnpm run gen:components && pnpm --filter @sunset-reverie/icons build",
    "build:ui": "pnpm run build:icons && pnpm --filter @sunset-reverie/ui build",
    "build": "pnpm run build:ui && pnpm --filter @sunset-reverie/resolver build && pnpm --filter @sunset-reverie/nuxt build",
    "typecheck": "pnpm run build:tokens && pnpm -r --filter \"./packages/*\" typecheck && pnpm --filter playground-vue3 typecheck",
    "test": "pnpm run build:tokens && pnpm -r --filter \"./packages/*\" test",
    "lint": "eslint . --max-warnings=0 && stylelint \"packages/**/*.less\" --allow-empty-input && node scripts/check-template-tags.mjs && node scripts/check-ref-unwrap.mjs && node scripts/check-docs.mjs && node scripts/check-tokens.mjs",
    "lint:naming": "node scripts/check-naming.mjs",
    "lint:icons": "node scripts/check-icons.mjs",
    "gen:icons": "node packages/icons/scripts/gen-offline-icons.mjs",
    "gen:components": "node scripts/sync-components.mjs",
    "gen:china-map": "node scripts/gen-china-map.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "release:pack": "node scripts/pack-release.mjs",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky",
    "check:docs": "node scripts/check-docs.mjs",
    "check:demo": "node scripts/check-demo.mjs --all",
    "check:layout": "node scripts/check-layout.mjs",
    "check:layout:docs": "node scripts/check-layout.mjs --docs",
    "check:layout:demo": "node scripts/check-layout.mjs --demo",
    "size": "node scripts/check-size.mjs",
    "check:visual": "playwright test --config playwright.visual.config.ts",
    "check:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:e2e": "pkill -f 'index[.]mjs' || true; rm -rf playground-nuxt4/.output; pnpm --filter playground-nuxt4 build && playwright test",
    "check:hydration": "pnpm --filter playground-nuxt4 build && node scripts/check-hydration.mjs",
    "lint:smoke": "node scripts/check-smoke-coverage.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "docs:api": "node scripts/extract-api.mjs",
    "gen:demo-props": "node scripts/extract-api.mjs > playground-vue3/src/demos/props.json",
    "lint:tags": "node scripts/check-template-tags.mjs",
    "lint:demo": "node scripts/check-demo-classes.mjs && node scripts/check-demo-imports.mjs && node scripts/check-demo-coverage.mjs",
    "lint:refs": "node scripts/check-ref-unwrap.mjs",
    "lint:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jsqr": "^1.4.0",
    "lint-staged": "^15.2.10",
    "postcss-less": "^6.0.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.less": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
